# Mnemosyne Inference — example configuration.
#
# Mount this file into the container at /config/config.yaml. The host path
# is conventionally ~/vllm-manager/config.yaml; the same directory holds .env
# (see .env.example). Secrets do NOT live in this file.
#
# Edit + `vllm-ctl reload` (or SIGHUP / POST /manager/reload) re-reads the
# file without restarting the container.

server:
  inference_port: 8000              # LAN-facing OpenAI-compatible API
  admin_port: 8001                  # /ui + /manager/*; protected by ADMIN_PASSWORD
  inference_bind: 0.0.0.0
  admin_bind: 0.0.0.0
  idle_unload_seconds: 900          # 15 min default; null disables idle eviction
  startup_timeout_seconds: 600
  swap_queue_timeout_seconds: 300   # how long /v1 waits during a model swap before 504
  max_concurrency: null             # optional ceiling; never raises engine-derived capacity
  max_queue_depth: 128              # bounded FIFO waiters; must be at least 1
  image_request_timeout_seconds: 1800
  image_max_pixels: 4194304         # 2048x2048; width/height must be multiples of 16

storage:
  default: nvme-fast
  locations:
    - name: nvme-fast
      path: /storage/nvme/hf-cache  # bind-mount the host drive here in compose
    - name: archive
      path: /storage/raid/hf-cache

defaults:
  gpu_memory_utilization: 0.90
  trust_remote_code: true
  max_model_len: null               # null → vLLM derives from model config

# Stable, non-secret identity advertised to an explicitly enrolled Nyx fleet
# gateway. When token_sidecar is enabled, use the same node_id in both blocks.
fleet:
  node_id: ""                       # e.g. "cuda-east"

# Optional: forward per-request token usage to a central Postgres ledger
# (DSN comes from TOKEN_SIDECAR_POSTGRES_DSN in .env). Each completed usage
# event commits local analytics and the SQLite delivery outbox atomically
# before response completion; Postgres delivery is then batched and retry-safe.
# Disabled by default.
token_sidecar:
  enabled: false
  node_id: ""                       # e.g. "Mnemosyne" — unique per host
  flush_interval_seconds: 30
  batch_size: 500
  max_outbox_rows: 100000           # outbox cap; oldest dropped past this

models:
  # Tensor-parallel across both GPUs.
  - alias: qwen-72b-awq
    model: Qwen/Qwen2.5-72B-Instruct-AWQ
    quantization: awq
    gpus: all                       # or [0] or [1] or [0,1]
    max_model_len: 32768
    storage: nvme-fast

  # Single GPU — pin to GPU 0.
  - alias: qwen-coder-7b
    model: Qwen/Qwen2.5-Coder-7B-Instruct
    gpus: [0]

  # Multimodal on GPU 1 with a vLLM flag passed through verbatim.
  - alias: llama-vision
    model: meta-llama/Llama-3.2-11B-Vision-Instruct
    gpus: [1]
    storage: archive
    extra_args:
      - --limit-mm-per-prompt
      - image=4

  # GGUF via llama.cpp. `extra_args` are llama-server startup defaults;
  # per-request sampler/reasoning/structured-output options pass through
  # the /v1/* proxy in the JSON body.
  - alias: local-gguf
    model: org/repo-gguf
    backend: llama.cpp
    gguf_filename: model.Q4_K_M.gguf
    gpus: [0]
    max_model_len: 32768
    extra_args:
      - --reasoning
      - off
      - --reasoning-format
      - none
      - --temp
      - "0.2"

  # Image generation uses the separately pinned SGLang Diffusion runtime.
  # Public guidance_scale maps to Qwen's true_cfg_scale parameter.
  - alias: qwen-image
    model: Qwen/Qwen-Image
    backend: sglang-diffusion
    kind: image
    gpus: [0]
    image:
      width: 1024
      height: 1024
      num_inference_steps: 30
      guidance_scale: 4.0
      guidance_parameter: true_cfg_scale

  - alias: krea-2-turbo
    model: krea/Krea-2-Turbo
    backend: sglang-diffusion
    kind: image
    gpus: [0]
    image:
      width: 1024
      height: 1024
      num_inference_steps: 8
      guidance_scale: 1.0
