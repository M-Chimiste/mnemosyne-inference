# Secrets for the native macOS service. Do not commit the populated file.

# OMLX_API_KEY=
# OMLX_ADMIN_SESSION=
# INFERENCE_API_KEY=
# ADMIN_PASSWORD=
# Hugging Face access for gated/private model discovery and downloads.
# HF_TOKEN=
# Central reporting defaults on. Existing installs can migrate this value from
# the previous sidecar's LaunchAgent into this private file; new installs should
# set it here.
# Set this through Settings > Usage > Postgres connection. Manual equivalent:
# TOKEN_SIDECAR_POSTGRES_DSN=postgresql://writer:password@server/token_sidecar
# Normally derived from the Mac's Computer Name. Legacy migration persists the
# previous sidecar's exact node ID here before that LaunchAgent is retired.
# MNEMOSYNE_REPORTING_NODE_ID=theseus
