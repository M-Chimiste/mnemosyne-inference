# Secrets for the native macOS service. Do not commit the populated file.

# OMLX_API_KEY=
# OMLX_ADMIN_SESSION=
# Optional on both loopback and local-network inference. When set, /v1/*
# requires Authorization: Bearer <key>; when absent, inference is unauthenticated.
# INFERENCE_API_KEY=
# Dedicated credential for the read-only fleet snapshot. Keep this distinct
# from the public inference credential.
# FLEET_API_KEY=
# Dedicated credential accepted only when the Hub supplies a canonical Fleet route
# marker. Existing static deployments may omit it and use INFERENCE_API_KEY.
# FLEET_INFERENCE_API_KEY=
# Pairing-owned Mac-to-Hub credential. The signed pairing flow writes this;
# do not copy or reuse another role's value.
# FLEET_MANAGEMENT_API_KEY=
# Locally pinned Ed25519 public key for an explicitly enabled signed catalog.
# The production release process supplies the value; never copy the repository
# test key or any private signing material here.
# MNEMOSYNE_CATALOG_PUBLIC_KEY_2026_A=
# ADMIN_PASSWORD=
# Hugging Face access for gated/private model discovery and downloads.
# HF_TOKEN=
# Central reporting defaults on. Existing installs can migrate this value from
# the previous sidecar's LaunchAgent into this private file; new installs should
# set it here.
# Set this through Settings > Usage > Postgres connection. Manual equivalent:
# TOKEN_SIDECAR_POSTGRES_DSN=postgresql://writer:password@server/token_sidecar
# Normally derived from the Mac's Computer Name. Legacy migration persists the
# previous sidecar's exact node ID here before that LaunchAgent is retired.
# MNEMOSYNE_REPORTING_NODE_ID=theseus
