# Mnemosyne native macOS configuration.
# Copy to ~/Library/Application Support/Mnemosyne/config.yaml.

schema_version: 6

server:
  # Settings > General switches this between 127.0.0.1 (This Mac only) and
  # 0.0.0.0 (all reachable interfaces, including the local network).
  inference_bind: 127.0.0.1
  inference_port: 1240
  control_bind: 127.0.0.1
  control_port: 17321
  # Keep the verified resident warm for responsive interactive use. Set a
  # positive number (for example 900) on a memory-constrained shared Mac.
  idle_unload_seconds: null
  startup_timeout_seconds: 900
  swap_queue_timeout_seconds: 300
  # null derives a conservative limit from each engine/profile. Set a positive
  # integer to cap that derived limit for every resident model.
  max_concurrency: null
  # Waiting requests only; warm requests with a free concurrency permit bypass
  # the queue without violating FIFO model-switch ordering.
  max_queue_depth: 128
  shutdown_grace_seconds: 30
  reconcile_interval_seconds: 30
  image_request_timeout_seconds: 1800
  image_max_pixels: 4194304
  startup_policy: unload_all
  # Authentication is optional on either bind. When this variable is set,
  # every /v1/* request must send Authorization: Bearer <key>.
  inference_api_key_env: INFERENCE_API_KEY
  fleet_api_key_env: FLEET_API_KEY
  control_password_env: ADMIN_PASSWORD

engines:
  # Unified Inference downloads an official Apple Silicon llama.cpp release,
  # verifies GitHub's published size and SHA-256, and owns one llama-server
  # process at a time. The managed active runtime overrides binary/working_directory.
  llama_cpp:
    enabled: true
    host: 127.0.0.1
    port: 17325
    binary: ~/Library/Application Support/Mnemosyne/runtimes/llama.cpp/not-installed/llama-server
    working_directory: ~/Library/Application Support/Mnemosyne
    process_state_path: ~/Library/Application Support/Mnemosyne/state/llama-cpp-process.json
    request_timeout_seconds: 30
    shutdown_grace_seconds: 30

  # Optional externally owned service. Enable this only after oMLX is installed
  # and listening on the configured loopback port. For strict lifecycle
  # control, disable oMLX model pinning/TTL and either disable its inner admin
  # auth or provide a working admin session via OMLX_ADMIN_SESSION.
  omlx:
    enabled: false
    base_url: http://127.0.0.1:17322
    api_key_env: OMLX_API_KEY
    admin_session_env: OMLX_ADMIN_SESSION
    request_timeout_seconds: 30
    # Finder-selected MLX library roots are added here by the import flow.
    model_directories: []

  # Preview: DS4 is launched and terminated by Mnemosyne. It is not a general
  # GGUF runtime; opt in only after installing it and selecting supported
  # weights.
  ds4:
    enabled: false
    host: 127.0.0.1
    port: 17323
    binary: /Applications/DwarfStar/ds4-server
    working_directory: /Applications/DwarfStar
    # Mnemosyne uses this identity record to prove that a recovered PID and
    # process group are its own before it ever sends a signal.
    process_state_path: ~/Library/Application Support/Mnemosyne/state/ds4-process.json
    request_timeout_seconds: 30
    shutdown_grace_seconds: 30

  # Preview: MFLUX runs in a separately locked, process-isolated worker bundled
  # with the menu app. Opt in when local image generation is wanted.
  mflux:
    enabled: false
    host: 127.0.0.1
    port: 17324
    request_timeout_seconds: 30
    shutdown_grace_seconds: 30

  # Preview: native Rust/MLX server. Install and upgrade the official Homebrew
  # formula separately (`brew tap lablup/tap && brew install mlxcel`). Unified
  # Inference owns only an exact model server process and never its formula.
  mlxcel:
    enabled: false
    host: 127.0.0.1
    port: 17326
    binary: /opt/homebrew/bin/mlxcel-server
    working_directory: ~/Library/Application Support/Mnemosyne
    process_state_path: ~/Library/Application Support/Mnemosyne/state/mlxcel-process.json
    request_timeout_seconds: 30
    shutdown_grace_seconds: 30

  # Preview: broad Safetensors runtime. The official mistral.rs installer owns
  # ~/.local/bin/mistralrs and its `mistralrs update` flow. Model Library still
  # pins and downloads every served snapshot before this process is launched.
  mistral_rs:
    enabled: false
    host: 127.0.0.1
    port: 17327
    binary: ~/.local/bin/mistralrs
    working_directory: ~/Library/Application Support/Mnemosyne
    process_state_path: ~/Library/Application Support/Mnemosyne/state/mistral-rs-process.json
    request_timeout_seconds: 30
    shutdown_grace_seconds: 30

paths:
  state_database: ~/Library/Application Support/Mnemosyne/state/mnemosyne.db
  log_directory: ~/Library/Application Support/Mnemosyne/logs

# Model downloads use these exact folders. The menu app's native folder
# chooser records the containing volume UUID for removable drives, so a
# missing drive or a different disk mounted at the same path fails closed.
storage:
  default: internal
  locations:
    - name: internal
      path: ~/Library/Application Support/Mnemosyne/models
    # Nested folders on external volumes are supported directly:
    # - name: athena-models
    #   path: /Volumes/Athena/models
    #   volume_uuid: 00000000-0000-0000-0000-000000000000

# Profiles are created through Model Library or Finder discovery. Fresh
# installs intentionally contain no placeholder model files, guessed external
# volumes, or assumed cache locations; the exact user-selected destinations
# are preserved when a model is installed or imported.
models: []

# One public alias can retain its current engine as an unconditional fallback
# while explicitly listing compatible local snapshots. `fixed` preserves the
# historical behavior. `benchmark` selects a different candidate only when
# fresh exact evidence clears the requested improvement threshold. `pinned`
# always prefers one explicitly named engine, independent of benchmark rank.
# models:
#   - alias: qwen
#     engine: omlx
#     model: Qwen-4bit
#     storage: internal
#     context:
#       # automatic applies a fresh long-prefill result for this exact runtime
#       # and Mac, otherwise it retains the safe load/engine fallback.
#       mode: automatic
#       native_tokens: 262144
#       max_verified_age_hours: 720
#       # Use mode: native to request the advertised maximum without profiling,
#       # or mode: fixed plus fixed_tokens for an explicit user-owned limit.
#     alternatives:
#       - engine: mlxcel
#         model: ~/Library/Application Support/Mnemosyne/models/mlxcel/mlx-community/Qwen-4bit
#         storage: internal
#         context:
#           mode: automatic
#           native_tokens: 262144
#         load:
#           parallel: 4
#     selection:
#       mode: pinned
#       pinned_engine: mlxcel
#       # Change mode to benchmark to use the ranking controls below instead.
#       objective: balanced
#       allow_preview: true
#       minimum_samples: 3
#       max_benchmark_age_hours: 168
#       minimum_improvement_percent: 5

# Version-1 LM Studio profiles are moved here automatically as inert alias and
# tuning records. Add Existing Models consumes matching records when the
# corresponding on-disk GGUF/MLX model is adopted; nothing here can load a
# model or contact LM Studio.
migration:
  legacy_lmstudio_profiles: []

# The DSN is secret. Set it through Settings > Usage > Postgres connection;
# the app stores TOKEN_SIDECAR_POSTGRES_DSN only in the private environment file.
token_sidecar:
  enabled: true
  # Empty migrates node.id from the previous sidecar's active LaunchAgent
  # config (for example theseus, metis, or athena), then falls back to the
  # normalized macOS computer name. Set a value only as an explicit override.
  node_id: ""
  flush_interval_seconds: 30
  batch_size: 500
  max_outbox_rows: 100000
  connect_timeout_seconds: 5
