+def test_real_flash_next_image_tower_changes_language_outputs(device):
+    from mlx_vlm.models.qwen4_exp.config import VisionConfig
+    from mlx_vlm.models.qwen4_exp.vision import VisionModel
+    from tensorfold.vision.qwen_mlx import QwenVisionFrontend
+    from tensorfold.vision.qwen_processing import PreparedVisionPrompt
+    from tensorfold.engine.lane_engine import LaneEngine
+
+    model = tiny(9)
+    runtime = FlashNext(model, drafts=0)
+    tower = VisionModel(VisionConfig(depth=1, hidden_size=32, intermediate_size=64, out_hidden_size=64,
+                                    num_heads=4, patch_size=2, temporal_patch_size=1, spatial_merge_size=2,
+                                    num_position_embeddings=16, deepstack_visual_indexes=[]))
+    front = QwenVisionFrontend.__new__(QwenVisionFrontend)
+    front.mx, front.tower, front.embed_tokens = mx, tower, model.model.embed_tokens
+    runtime.vision = front
+    prompt = image_prompt(model)
+    predictions = []
+    for color in (0.2, 0.8):
+        prepared = PreparedVisionPrompt(prompt.token_ids, np.full((16, 12), color, np.float32),
+                                        np.array([[1, 4, 4]]), np.array(prompt.position_ids), -2,
+                                        ((4, 8),), (str(color),))
+        cache = runtime.make_cache()
+        encoded = runtime.encode_vision(prepared, cache)
+        hidden = runtime.prefill_vision(mx.array([encoded.token_ids]), cache, encoded, 0, 24)
+        predictions.append(np.array(runtime.head(hidden[:, -1:])))
+    assert not np.allclose(predictions[0], predictions[1], atol=1e-5)
+    engine = LaneEngine(runtime, max_rows=1, max_draft=0, retain_finished_caches=False)
+    last = engine._family_feed(prompt.token_ids, runtime.make_cache(), [(0, 5), (5, 24)], encoded)
+    assert last.shape == (1, 1, model.args.hidden_size)
+    np.testing.assert_allclose(np.array(runtime.head(last)), predictions[-1], atol=3e-4, rtol=3e-4)
