+def image_prompt(model, width=24, color=1.0):
+    tokens = tuple(range(6, 6 + width))
+    positions = np.broadcast_to(np.arange(width), (3, 1, width)).copy()
+    positions[:, :, 4:8] = [[[4, 4, 4, 4]], [[4, 4, 5, 5]], [[4, 5, 4, 5]]]
+    positions[:, :, 8:] -= 2
+    embeds = model.model.embed_tokens(mx.array([tokens]))
+    embeds[:, 4:8] = color * mx.ones((1, 4, model.args.hidden_size))
+    return SimpleNamespace(token_ids=tokens, inputs_embeds=embeds,
+                           position_ids=mx.array(positions, dtype=mx.int32), rope_delta=-2)
+
+
+@pytest.mark.parametrize("dtype", [mx.float32, mx.bfloat16])
+def test_rotary_matches_official_mlx_vlm(device, dtype):
+    from mlx_vlm.models.qwen3_5.language import Qwen3_5RotaryEmbedding
+
+    positions = mx.array([[[4, 4, 4]], [[4, 5, 6]], [[4, 6, 5]]], dtype=mx.int32)
+    x = mx.array(np.arange(60, dtype=np.float32).reshape(1, 2, 3, 10) / 20).astype(dtype)
+    reference = Qwen3_5RotaryEmbedding(8, base=10000, mrope_section=[2, 1, 1])
+    expected, _ = reference.apply_rotary(x, x, positions)
+    tolerance = 0.03 if dtype == mx.bfloat16 else 2e-6
+    np.testing.assert_allclose(np.array(apply_positions(x, positions, 8, 10000, [2, 1, 1]).astype(mx.float32)),
+                               np.array(expected.astype(mx.float32)), atol=tolerance, rtol=tolerance)
+
+
+def test_image_prefill_chunking_and_decode_positions(device):
+    model = tiny(17)
+    model.layers[-1].self_attn.split_keys = 12
+    model.layers[-1].self_attn.split_rows = 3
+    runtime = FlashNext(model, drafts=0)
+    encoded = image_prompt(model)
+    runtime.vision = SimpleNamespace(encode=lambda prepared: prepared)
+    whole, chunked = runtime.make_cache(), runtime.make_cache()
+    runtime.encode_vision(encoded, whole)
+    runtime.encode_vision(encoded, chunked)
+    a = runtime.prefill_vision(mx.array([encoded.token_ids]), whole, encoded, 0, 24)
+    for begin, end in ((0, 5), (5, 11), (11, 24)):
+        b = runtime.prefill_vision(mx.array([encoded.token_ids[begin:end]]), chunked, encoded, begin, end)
+    assert a.shape == (1, 24, model.args.hidden_size)  # hidden, not vocabulary logits
+    np.testing.assert_allclose(np.array(a[:, -1]), np.array(b[:, -1]), atol=3e-4, rtol=3e-4)
+    next_a, next_b = runtime.hidden([33], whole), runtime.hidden([33], chunked)
+    np.testing.assert_allclose(np.array(next_a), np.array(next_b), atol=3e-4, rtol=3e-4)
+    expected = np.concatenate([np.array(encoded.position_ids), np.full((3, 1, 1), 22)], axis=-1)
+    for cache in (whole, chunked):
+        np.testing.assert_array_equal(np.array(cache[-1].index_position_ids), expected)
+        assert any(value is cache[-1].index_position_ids for value in cache[-1].state)
+    chunked[-1].trim(1)
+    np.testing.assert_array_equal(np.array(chunked[-1].index_position_ids), np.array(encoded.position_ids))
+
