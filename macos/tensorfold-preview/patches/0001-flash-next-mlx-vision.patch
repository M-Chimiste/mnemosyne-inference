+def test_sparse_indexer_matches_official_image_selection(device):
+    from mlx_vlm.models.qwen4_exp.config import TextConfig
+    from mlx_vlm.models.qwen4_exp.language import QSAKVCache, Qwen4ExpQSAIndexer
+    from mlx_vlm.models.qwen3_5.language import Qwen3_5RotaryEmbedding
+
+    model = tiny(31)
+    indexer = model.layers[-1].self_attn.indexer
+    encoded = image_prompt(model)
+    x = mx.random.normal((1, 24, model.args.hidden_size))
+    query, keys = indexer.project(x)
+    cache = model.make_cache()[-1]
+    cache.index_position_ids = encoded.position_ids
+    actual = indexer.select(query, keys, cache, 0)
+    config = TextConfig.from_dict({**TEXT, "model_type": "qwen4_exp", "max_position_embeddings": 1024,
+                                 "rope_parameters": {**TEXT["rope_parameters"], "type": "default"}})
+    rope = Qwen3_5RotaryEmbedding(8, base=10000, mrope_section=[2, 1, 1])
+    reference = Qwen4ExpQSAIndexer(config, rope)
+    reference.index_qk_proj.weight = indexer.index_qk_proj.weight
+    reference.q_layernorm.weight = indexer.q_layernorm.weight
+    reference.k_layernorm.weight = indexer.k_layernorm.weight
+    expected = reference(x, QSAKVCache(), encoded.position_ids)
+    np.testing.assert_array_equal(np.array(actual), np.array(expected))
+
