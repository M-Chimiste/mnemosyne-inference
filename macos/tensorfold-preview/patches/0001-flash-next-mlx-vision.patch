+def test_changed_visual_features_change_target_logits_and_do_not_leak(device):
+    model = tiny(5)
+    runtime = FlashNext(model, drafts=0)
+    runtime.vision = SimpleNamespace(encode=lambda prepared: prepared)
+    results = []
+    for color in (-1.0, 1.0):
+        encoded = image_prompt(model, color=color)
+        cache = runtime.make_cache()
+        runtime.encode_vision(encoded, cache)
+        hidden = runtime.prefill_vision(mx.array([encoded.token_ids]), cache, encoded, 0, 24)
+        results.append(np.array(runtime.head(hidden[:, -1:])))
+    assert not np.allclose(results[0], results[1], atol=1e-5)
+    fresh = runtime.make_cache()
+    text = runtime.hidden([8, 9, 10], fresh)
+    assert fresh[-1].index_position_ids is None and not fresh[-1].vision_enabled
+    np.testing.assert_array_equal(np.array(text), np.array(model.hidden([8, 9, 10], model.make_cache())))
+    with pytest.raises(ValueError, match="fresh cache"):
+        runtime.encode_vision(encoded, fresh)
+
