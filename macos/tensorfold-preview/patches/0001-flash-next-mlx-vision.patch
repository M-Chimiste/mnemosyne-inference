+"""Isolated Flash Next Preview image prefill and continuation, on tiny MLX models."""
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+mx = pytest.importorskip("mlx.core")
+
+from tensorfold.families.qwen4_exp.runtime import FlashNext
+from tensorfold.vision.rotary import apply_positions, vision_positions
+from test_qwen4_exp_family import tiny, TEXT
+
+
+@pytest.fixture(params=[mx.cpu, mx.gpu])
+def device(request):
+    if request.param == mx.gpu and not mx.metal.is_available():
+        pytest.skip("Metal unavailable")
+    previous = mx.default_device()
+    mx.set_default_device(request.param)
+    yield
+    mx.set_default_device(previous)
+
