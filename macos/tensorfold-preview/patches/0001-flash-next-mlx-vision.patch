+@pytest.mark.parametrize("bits", [4, 6])
+def test_quantized_image_prefill_and_continuation_are_finite(device, bits):
+    import mlx.nn as nn
+
+    model = tiny(23)
+    nn.quantize(model, group_size=32, bits=bits,
+                class_predicate=lambda path, module: hasattr(module, "to_quantized")
+                and len(module.weight.shape) == 2 and module.weight.shape[-1] % 32 == 0)
+    runtime = FlashNext(model, drafts=0)
+    runtime.vision = SimpleNamespace(encode=lambda prepared: prepared)
+    encoded = image_prompt(model)
+    cache = runtime.make_cache()
+    runtime.encode_vision(encoded, cache)
+    hidden = runtime.prefill_vision(mx.array([encoded.token_ids]), cache, encoded, 0, 24)
+    assert bool(mx.all(mx.isfinite(runtime.head(hidden[:, -1:]))).item())
+    assert bool(mx.all(mx.isfinite(runtime.head(runtime.hidden([33], cache)))).item())
