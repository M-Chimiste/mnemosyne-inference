{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemosyne.local/schemas/mac-pool/placement/v1/placement_recommendation.schema.json",
  "title": "Mnemosyne PlacementRecommendation v1",
  "description": "Immutable, path-free and advisory Mac/storage placement result. It never selects a target or grants install or inference authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_id",
    "scorer_version",
    "created_at",
    "expires_at",
    "catalog_version",
    "catalog_digest",
    "request",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "recommendation_id": {
      "$ref": "#/$defs/uuid"
    },
    "scorer_version": {
      "const": "mac-placement-v1"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "catalog_version": {
      "$ref": "#/$defs/safe_version"
    },
    "catalog_digest": {
      "$ref": "#/$defs/sha256"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "candidates": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safe_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
    },
    "safe_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^/\\\\\\u0000-\\u001f]{1,64}$"
    },
    "timestamp": {
      "type": "number",
      "minimum": 0,
      "maximum": 4102444800
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "byte_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1152921504606846976
    },
    "signed_byte_count": {
      "type": "integer",
      "minimum": -1152921504606846976,
      "maximum": 1152921504606846976
    },
    "nullable_byte_count": {
      "anyOf": [
        {
          "$ref": "#/$defs/byte_count"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_signed_byte_count": {
      "anyOf": [
        {
          "$ref": "#/$defs/signed_byte_count"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_uuid": {
      "anyOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_generation": {
      "anyOf": [
        {
          "$ref": "#/$defs/generation"
        },
        {
          "type": "null"
        }
      ]
    },
    "capability": {
      "enum": [
        "chat/completions",
        "completions",
        "embeddings",
        "messages",
        "rerank",
        "responses"
      ]
    },
    "engine": {
      "enum": [
        "ds4",
        "llama.cpp",
        "omlx"
      ]
    },
    "service_class": {
      "enum": [
        "primary",
        "opportunistic",
        "overflow"
      ]
    },
    "evidence_class": {
      "enum": [
        "measured",
        "catalog_tested",
        "calculated",
        "conservative"
      ]
    },
    "reason_code": {
      "enum": [
        "architecture_unsupported",
        "capability_unsupported",
        "catalog_mismatch",
        "concurrency_unsupported",
        "context_unsupported",
        "credential_generation_changed",
        "exact_artifact_reuse",
        "gpu_requirement_unmet",
        "hardware_feature_evidence_missing",
        "hub_remote_installs_disabled",
        "hub_restarted",
        "insufficient_memory_budget",
        "insufficient_storage",
        "inventory_identity_mismatch",
        "local_approval_required",
        "low_power_mode",
        "memory_estimate_unavailable",
        "memory_headroom_available",
        "os_unsupported",
        "pairing_inactive",
        "pairing_revoked",
        "participation_draining",
        "participation_paused",
        "platform_unsupported",
        "power_ac",
        "power_battery",
        "pressure_deprioritized",
        "recipe_known_bad",
        "recipe_not_verified",
        "remote_installs_local_only",
        "runtime_catalog_mismatch",
        "runtime_compatible_unverified",
        "runtime_compatible_verified",
        "runtime_disabled",
        "runtime_feature_evidence_missing",
        "runtime_fingerprint_mismatch",
        "runtime_install_approval_required",
        "runtime_install_required",
        "runtime_known_bad",
        "runtime_unavailable",
        "runtime_unhealthy",
        "runtime_version_mismatch",
        "service_class_excluded",
        "service_opportunistic",
        "service_overflow",
        "service_primary",
        "soc_unsupported",
        "stale_inventory",
        "storage_binding_changed",
        "storage_capacity_unknown",
        "storage_headroom_available",
        "storage_not_registered",
        "storage_not_writable",
        "storage_unavailable",
        "unified_memory_requirement_unmet"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_model_id",
        "recipe_id",
        "artifact_id",
        "engine",
        "required_capabilities",
        "required_context_tokens",
        "required_concurrency",
        "allowed_service_classes"
      ],
      "properties": {
        "logical_model_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "recipe_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "artifact_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "required_context_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "required_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "allowed_service_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/service_class"
          }
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairing_id",
        "credential_generation",
        "inventory_instance_id",
        "inventory_sequence",
        "inventory_received_at",
        "basis_expires_at",
        "storage_location_id",
        "storage_binding_generation",
        "catalog_digest"
      ],
      "properties": {
        "pairing_id": {
          "$ref": "#/$defs/uuid"
        },
        "credential_generation": {
          "$ref": "#/$defs/generation"
        },
        "inventory_instance_id": {
          "$ref": "#/$defs/uuid"
        },
        "inventory_sequence": {
          "$ref": "#/$defs/sequence"
        },
        "inventory_received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "basis_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "storage_location_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "storage_binding_generation": {
          "$ref": "#/$defs/nullable_generation"
        },
        "catalog_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "storage_location_id": {
                "type": "null"
              }
            },
            "required": [
              "storage_location_id"
            ]
          },
          "then": {
            "properties": {
              "storage_binding_generation": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "storage_binding_generation": {
                "$ref": "#/$defs/generation"
              }
            }
          }
        }
      ]
    },
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "hardware",
        "memory",
        "runtime",
        "storage"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/evidence_class"
        },
        "hardware": {
          "$ref": "#/$defs/evidence_class"
        },
        "memory": {
          "$ref": "#/$defs/evidence_class"
        },
        "runtime": {
          "$ref": "#/$defs/evidence_class"
        },
        "storage": {
          "$ref": "#/$defs/evidence_class"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "evidence_class",
        "observed_at",
        "explanation"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/reason_code"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f]{1,160}$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairing_display_name",
        "service_class",
        "basis",
        "eligible",
        "order",
        "hard_gate_codes",
        "artifact_reuse",
        "runtime_state",
        "estimated_download_bytes",
        "estimated_peak_memory_bytes",
        "memory_headroom_bytes",
        "storage_headroom_bytes",
        "requires_local_approval",
        "power_policy",
        "evidence",
        "reasons"
      ],
      "properties": {
        "pairing_display_name": {
          "$ref": "#/$defs/display_name"
        },
        "service_class": {
          "$ref": "#/$defs/service_class"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "eligible": {
          "type": "boolean"
        },
        "order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4096
        },
        "hard_gate_codes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        },
        "artifact_reuse": {
          "enum": [
            "none",
            "verified_exact"
          ]
        },
        "runtime_state": {
          "enum": [
            "compatible_verified",
            "compatible_unverified",
            "install_managed",
            "install_requires_approval",
            "unavailable"
          ]
        },
        "estimated_download_bytes": {
          "$ref": "#/$defs/byte_count"
        },
        "estimated_peak_memory_bytes": {
          "$ref": "#/$defs/nullable_byte_count"
        },
        "memory_headroom_bytes": {
          "$ref": "#/$defs/nullable_signed_byte_count"
        },
        "storage_headroom_bytes": {
          "$ref": "#/$defs/nullable_signed_byte_count"
        },
        "requires_local_approval": {
          "type": "boolean"
        },
        "power_policy": {
          "enum": [
            "preferred",
            "deprioritized",
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence_summary"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": true
              }
            },
            "required": [
              "eligible"
            ]
          },
          "then": {
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "hard_gate_codes": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "order": {
                "type": "null"
              },
              "hard_gate_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
